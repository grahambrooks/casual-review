{
  "name": "casual-review",
  "displayName": "Casual Review",
  "description": "Read, write, and sync code-review comments stored in git notes via the cr CLI.",
  "version": "0.1.0",
  "publisher": "casual-review",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/grahambrooks/casual-review"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "casualReview.addComment",
        "title": "Casual Review: Add Comment on Selection"
      },
      {
        "command": "casualReview.replyToComment",
        "title": "Casual Review: Reply to Comment",
        "icon": "$(reply)"
      },
      {
        "command": "casualReview.resolveComment",
        "title": "Casual Review: Resolve Comment",
        "icon": "$(check)"
      },
      {
        "command": "casualReview.sync",
        "title": "Casual Review: Sync (fetch + push)"
      },
      {
        "command": "casualReview.fetch",
        "title": "Casual Review: Fetch"
      },
      {
        "command": "casualReview.push",
        "title": "Casual Review: Push"
      },
      {
        "command": "casualReview.refresh",
        "title": "Casual Review: Refresh Comments"
      },
      {
        "command": "casualReview.showStale",
        "title": "Casual Review: Show Stale Comments"
      },
      {
        "command": "casualReview.openComment",
        "title": "Casual Review: Open Comment"
      },
      {
        "command": "casualReview.refreshTree",
        "title": "Casual Review: Refresh Comments",
        "icon": "$(refresh)"
      },
      {
        "command": "casualReview.syncTree",
        "title": "Casual Review: Sync (fetch + push)",
        "icon": "$(sync)"
      }
    ],
    "viewsContainers": {
      "activityBar": [
        {
          "id": "casualReview",
          "title": "Casual Review",
          "icon": "media/comments.svg"
        }
      ]
    },
    "views": {
      "casualReview": [
        {
          "id": "casualReview.comments",
          "name": "Review Comments",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Casual Review"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "casualReview.comments",
        "contents": "No open review comments in this repository.\nUse [Add Comment on Selection](command:casualReview.addComment) from the editor, then [Refresh](command:casualReview.refresh)."
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "casualReview.addComment",
          "group": "casualReview@1",
          "when": "editorTextFocus"
        }
      ],
      "view/title": [
        {
          "command": "casualReview.refreshTree",
          "when": "view == casualReview.comments",
          "group": "navigation@1"
        },
        {
          "command": "casualReview.syncTree",
          "when": "view == casualReview.comments",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "casualReview.replyToComment",
          "when": "view == casualReview.comments && viewItem == casualReview.thread",
          "group": "inline@1"
        },
        {
          "command": "casualReview.resolveComment",
          "when": "view == casualReview.comments && viewItem == casualReview.thread",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Casual Review",
      "properties": {
        "casualReview.binPath": {
          "type": "string",
          "default": "cr",
          "description": "Path to the cr binary. Use an absolute path if cr is not on PATH for the VS Code process."
        },
        "casualReview.includeAncestors": {
          "type": "boolean",
          "default": true,
          "description": "Project comments from ancestor commits onto HEAD."
        },
        "casualReview.remote": {
          "type": "string",
          "default": "origin",
          "description": "Default remote for sync/fetch/push."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
